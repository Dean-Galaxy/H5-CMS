# Protected staff and viewer acceptance entry. Explicit viewer-preview phase; never default TLS.
# Retains existing TLS, Basic and application staff/MFA protection.
# Browser-selected uploads remain in staff UI. No new mail, checkout, ad collection or webhook release.
server {
    listen 80 default_server;
    server_name _;
    access_log off;
    error_log /dev/null crit;
    server_tokens off;
    return 444;
}
server {
    listen 80;
    server_name __DOMAIN__;
    access_log off;
    error_log /dev/null crit;
    server_tokens off;
    if ($host != __DOMAIN__) { return 444; }
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 503; }
}

# Maintenance TLS only: no application/PHP/upstream. Install in a separately approved window.
server {
    listen 443 ssl default_server;
    server_name _;
    access_log off;
    error_log /dev/null crit;
    server_tokens off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_reject_handshake on;
    return 444;
}
server {
    listen 443 ssl;
    server_name __DOMAIN__;
    access_log off;
    error_log /dev/null crit;
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($host != __DOMAIN__) { return 444; }
    root /srv/h5/current/h5-platform/public;
    client_max_body_size 2m;
    auth_basic "H5 restricted staging";
    auth_basic_user_file /etc/nginx/h5-staging.htpasswd;
    add_header X-Content-Type-Options nosniff always;

    # No webhook exception and no proxy/country headers trusted from the browser.
    location ~ /\. { deny all; }
    # Use the real application's staff prefix, not /api/admin/v1.
    location ~ "^/(?:admin(?:/|$)|api/v1/admin(?:/|$)|livewire(?:-[a-f0-9]{8})?(?:/|$))" {
        fastcgi_pass unix:/run/php/h5-staging.sock;
        fastcgi_pass_request_headers off;
        fastcgi_param SCRIPT_FILENAME /srv/h5/current/h5-platform/public/index.php;
        fastcgi_param QUERY_STRING $query_string;
        fastcgi_param REQUEST_METHOD $request_method;
        fastcgi_param CONTENT_TYPE $content_type;
        fastcgi_param CONTENT_LENGTH $content_length;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param DOCUMENT_URI /index.php;
        fastcgi_param DOCUMENT_ROOT /srv/h5/current/h5-platform/public;
        fastcgi_param SERVER_PROTOCOL $server_protocol;
        fastcgi_param REQUEST_SCHEME https;
        fastcgi_param HTTPS on;
        fastcgi_param GATEWAY_INTERFACE CGI/1.1;
        fastcgi_param SERVER_SOFTWARE nginx;
        fastcgi_param REMOTE_ADDR $remote_addr;
        fastcgi_param REMOTE_PORT $remote_port;
        fastcgi_param SERVER_ADDR $server_addr;
        fastcgi_param SERVER_PORT 443;
        fastcgi_param SERVER_NAME __DOMAIN__;
        fastcgi_param REDIRECT_STATUS 200;
        # Explicit browser/webhook header allowlist; no client supplied proxy/country identity.
        fastcgi_param HTTP_HOST __DOMAIN__;
        fastcgi_param HTTP_ACCEPT $http_accept;
        fastcgi_param HTTP_ACCEPT_LANGUAGE $http_accept_language;
        fastcgi_param HTTP_COOKIE $http_cookie;
        fastcgi_param HTTP_USER_AGENT $http_user_agent;
        fastcgi_param HTTP_ORIGIN $http_origin;
        fastcgi_param HTTP_SEC_FETCH_SITE $http_sec_fetch_site if_not_empty;
        fastcgi_param HTTP_PURPOSE $http_purpose if_not_empty;
        fastcgi_param HTTP_SEC_PURPOSE $http_sec_purpose if_not_empty;
        fastcgi_param HTTP_REFERER $http_referer;
        fastcgi_param HTTP_X_CSRF_TOKEN $http_x_csrf_token;
        fastcgi_param HTTP_X_XSRF_TOKEN $http_x_xsrf_token;
        fastcgi_param HTTP_X_REQUESTED_WITH $http_x_requested_with;
        fastcgi_param HTTP_X_LIVEWIRE $http_x_livewire;
        fastcgi_param HTTP_RANGE $http_range if_not_empty;
        fastcgi_param HTTP_IF_RANGE $http_if_range if_not_empty;
        fastcgi_param HTTP_UPLOAD_OFFSET $http_upload_offset if_not_empty;
        fastcgi_param HTTP_IDEMPOTENCY_KEY $http_idempotency_key;
        fastcgi_param HTTP_STRIPE_SIGNATURE $http_stripe_signature;
        fastcgi_param HTTP_PAYPAL_AUTH_ALGO $http_paypal_auth_algo;
        fastcgi_param HTTP_PAYPAL_CERT_URL $http_paypal_cert_url;
        fastcgi_param HTTP_PAYPAL_TRANSMISSION_ID $http_paypal_transmission_id;
        fastcgi_param HTTP_PAYPAL_TRANSMISSION_SIG $http_paypal_transmission_sig;
        fastcgi_param HTTP_PAYPAL_TRANSMISSION_TIME $http_paypal_transmission_time;
        fastcgi_read_timeout 120s;
    }
    # Existing real user pages and playback only. Registration mail and purchase writes stay closed.
    location ~ "^/(?:$|catalog$|dramas(?:/|$)|audience/dramas/|identity/(?:login|account|register|forgot-password|reset-password)$|api/v1/auth/(?:csrf|me|login|logout)$|api/v1/content/(?:images|playback)/|api/v1/(?:home|categories|catalog)$|api/v1/dramas/|api/v1/episodes/[^/]+/playback-grants$|api/v1/me/(?:progress/|membership$)|membership$)" {
        fastcgi_pass unix:/run/php/h5-staging.sock;
        fastcgi_pass_request_headers off;
        fastcgi_param SCRIPT_FILENAME /srv/h5/current/h5-platform/public/index.php;
        fastcgi_param QUERY_STRING $query_string;
        fastcgi_param REQUEST_METHOD $request_method;
        fastcgi_param CONTENT_TYPE $content_type;
        fastcgi_param CONTENT_LENGTH $content_length;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param DOCUMENT_URI /index.php;
        fastcgi_param DOCUMENT_ROOT /srv/h5/current/h5-platform/public;
        fastcgi_param SERVER_PROTOCOL $server_protocol;
        fastcgi_param REQUEST_SCHEME https;
        fastcgi_param HTTPS on;
        fastcgi_param GATEWAY_INTERFACE CGI/1.1;
        fastcgi_param SERVER_SOFTWARE nginx;
        fastcgi_param REMOTE_ADDR $remote_addr;
        fastcgi_param REMOTE_PORT $remote_port;
        fastcgi_param SERVER_ADDR $server_addr;
        fastcgi_param SERVER_PORT 443;
        fastcgi_param SERVER_NAME __DOMAIN__;
        fastcgi_param REDIRECT_STATUS 200;
        # Explicit browser/webhook header allowlist; no client supplied proxy/country identity.
        fastcgi_param HTTP_HOST __DOMAIN__;
        fastcgi_param HTTP_ACCEPT $http_accept;
        fastcgi_param HTTP_ACCEPT_LANGUAGE $http_accept_language;
        fastcgi_param HTTP_COOKIE $http_cookie;
        fastcgi_param HTTP_USER_AGENT $http_user_agent;
        fastcgi_param HTTP_ORIGIN $http_origin;
        fastcgi_param HTTP_SEC_FETCH_SITE $http_sec_fetch_site if_not_empty;
        fastcgi_param HTTP_PURPOSE $http_purpose if_not_empty;
        fastcgi_param HTTP_SEC_PURPOSE $http_sec_purpose if_not_empty;
        fastcgi_param HTTP_REFERER $http_referer;
        fastcgi_param HTTP_X_CSRF_TOKEN $http_x_csrf_token;
        fastcgi_param HTTP_X_XSRF_TOKEN $http_x_xsrf_token;
        fastcgi_param HTTP_X_REQUESTED_WITH $http_x_requested_with;
        fastcgi_param HTTP_X_LIVEWIRE $http_x_livewire;
        fastcgi_param HTTP_RANGE $http_range if_not_empty;
        fastcgi_param HTTP_IF_RANGE $http_if_range if_not_empty;
        fastcgi_param HTTP_UPLOAD_OFFSET $http_upload_offset if_not_empty;
        fastcgi_param HTTP_IDEMPOTENCY_KEY $http_idempotency_key;
        fastcgi_param HTTP_STRIPE_SIGNATURE $http_stripe_signature;
        fastcgi_param HTTP_PAYPAL_AUTH_ALGO $http_paypal_auth_algo;
        fastcgi_param HTTP_PAYPAL_CERT_URL $http_paypal_cert_url;
        fastcgi_param HTTP_PAYPAL_TRANSMISSION_ID $http_paypal_transmission_id;
        fastcgi_param HTTP_PAYPAL_TRANSMISSION_SIG $http_paypal_transmission_sig;
        fastcgi_param HTTP_PAYPAL_TRANSMISSION_TIME $http_paypal_transmission_time;
        fastcgi_read_timeout 120s;
    }
    location ~ "^/(?:identity\.(?:css|js)|audience/[^/]+\.(?:css|js)|vendor/hls\.js/1\.7\.3/hls\.min\.js)$" {
        gzip on;
        gzip_types text/css application/javascript;
        gzip_vary on;
        gzip_min_length 1024;
        add_header Cache-Control "private, max-age=3600";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }
    # Only actual staff UI assets; never a general public-root file server.
    location ~ ^/(?:admin-ui/[^/]+\.(?:css|js|svg)|(?:css|js|fonts)/filament/.+\.(?:css|js|woff2?|ttf|svg)|content/(?:admin\.css|admin\.js|errors\.js|settings\.js))$ {
        gzip on;
        gzip_types text/css application/javascript image/svg+xml;
        gzip_vary on;
        gzip_min_length 1024;
        add_header Cache-Control "private, max-age=3600";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }
    location = /favicon.ico { try_files $uri =404; }
    location / { return 503; }
}
