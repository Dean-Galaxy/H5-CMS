[Unit]
Description=H5 isolated staging queue
After=network-online.target postgresql.service
Wants=network-online.target
[Service]
Type=simple
User=h5
Group=h5
WorkingDirectory=/srv/h5/current/h5-platform
Environment=APP_ENV=staging
ExecStartPre=/usr/bin/php /srv/h5/current/scripts/ops/check_runtime.php --expect-env=staging --require-cache
ExecStart=/usr/bin/php artisan queue:work --queue=h5_staging --sleep=1 --tries=3 --timeout=60 --max-time=3600
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=1200
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/h5/shared /srv/h5/current/h5-platform/bootstrap/cache
[Install]
WantedBy=multi-user.target
