LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
H5_BILLING_DRIVER=unconfigured
H5_BILLING_STRIPE_TEST_SECRET=
H5_BILLING_STRIPE_TEST_WEBHOOK_SECRET=
