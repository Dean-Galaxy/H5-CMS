[Unit]
Description=Independent H5 operations alerts
ConditionPathExists=/etc/h5/operations-alerts.json

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=h5-operations-alerts
StateDirectoryMode=0700
LoadCredential=alert-config:/etc/h5/operations-alerts.json
ExecStart=/usr/bin/python3 /usr/local/lib/h5-ops/operations_alerts.py
TimeoutStartSec=45s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
