{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyProjectBackupRoleInApprovedRegion",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::__ACCOUNT_ID__:role/h5-sparklingshort-staging-backup",
      "Condition": {
        "StringEquals": {"aws:RequestedRegion": "us-east-1"},
        "Bool": {"aws:SecureTransport": "true"}
      }
    }
  ]
}
