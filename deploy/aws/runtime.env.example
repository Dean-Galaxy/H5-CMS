# launch-prep-1, secretless OFFLINE candidate. Not an approved resource plan or live .env.
# Leave account/region/domain/mail identity and all secrets blank pending authorized provisioning.
# AWS_REGION is planning metadata only; it never supplies the visitor country.
AWS_REGION=
APP_NAME=H5
APP_ENV=staging
APP_DEBUG=false
APP_KEY=
APP_URL=
H5_WORKSPACE=h5_staging
H5_CONTROLLED_STAGING=true
H5_SIMULATION=false
H5_LOCAL_US_TEST_REGION=false
H5_LOCAL_MODULES=
H5_C_EXPERIENCE_ENABLED=false
H5_C_REGISTRATION_ENABLED=false
H5_MEDIA_ROOT=/srv/h5/shared/media
CONTENT_FFMPEG=/usr/bin/ffmpeg
CONTENT_FFPROBE=/usr/bin/ffprobe
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=h5_staging
DB_USERNAME=h5_staging
DB_PASSWORD=
SESSION_COOKIE=h5_staging
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
CACHE_PREFIX=h5_staging
QUEUE_CONNECTION=database
DB_QUEUE=h5_staging
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_REQUIRE_TLS=true
MAIL_TIMEOUT=10
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=H5
# Omit MAIL_URL and MAIL_EHLO_DOMAIN: null URL; EHLO defaults to APP_URL hostname.
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
H5_BILLING_DRIVER=unconfigured
H5_BILLING_NEW_PURCHASE_PROVIDER=unconfigured
H5_BILLING_PAYPAL_SANDBOX_ENABLED=false
ACQUISITION_TRANSPORT=disabled
ACQUISITION_EXTERNAL_ENABLED=false
ACQUISITION_PLATFORM_REVIEWED=false
ACQUISITION_CREDENTIALS_FILE=
# Do not add real payment/cloud/ad credentials, fake GeoIP, proxy headers or local overrides.
