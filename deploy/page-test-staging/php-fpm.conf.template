[h5-page-test]
user = h5_page_test
group = h5_page_test
listen = /run/php/h5-page-test.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = 1
pm.process_idle_timeout = 10s
pm.max_requests = 100
clear_env = yes
; Required when Laravel configuration is cached; never infer this from .env.
env[APP_ENV] = staging
env[APP_CONFIG_CACHE] = /srv/h5-page-test/shared/bootstrap/config.php
catch_workers_output = no
security.limit_extensions = .php
php_admin_flag[display_errors] = off
php_admin_flag[expose_php] = off
php_admin_value[upload_max_filesize] = 2M
php_admin_value[post_max_size] = 2M
php_admin_value[memory_limit] = 256M
php_admin_value[session.cookie_secure] = 1
php_admin_value[session.cookie_httponly] = 1
; Laravel's reviewed exception logger is the application channel; do not log raw request URLs.
