# Standalone named TLS vhost, no default_server. Render all placeholders first.
# __LIVEWIRE__ retains the hashed route. The login HTML advertises /admin/livewire/update.
# Include this map in http {}, not inside another server.
map "$request_method:$uri" $h5_page_test_allowed {
    default 0;
    ~^GET:/(admin/?|admin/login|admin/acquisition-desk|admin/acquisition-page-test|membership)$ 1;
    ~^POST:/admin/logout$ 1;
    ~^GET:/admin/multi-factor-authentication/(set-up|challenge)$ 1;
    ~^POST:/__LIVEWIRE__/update$ 1;
    ~^POST:/admin/livewire/update$ 1;
    ~^(GET|POST):/admin/acquisition-page-test$ 1;
    ~^POST:/admin/acquisition-page-test/withdraw$ 1;
    ~^GET:/api/v1/auth/csrf$ 1;
    ~^GET:/api/v1/tracking/context$ 1;
    ~^POST:/api/v1/tracking/consent$ 1;
}
server {
    listen 443 ssl;
    server_name staging.sparklingshort.com;
    ssl_certificate /etc/letsencrypt/live/staging.sparklingshort.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.sparklingshort.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($host != staging.sparklingshort.com) { return 444; }
    auth_basic off;
    root /srv/h5-page-test/current/h5-platform/public;
    access_log off;
    error_log /dev/null crit;
    add_header Cache-Control "no-store, private" always;
    add_header X-Content-Type-Options nosniff always;
    client_max_body_size 128k;
    location ~ /\. { return 404; }
    location ~ ^/identity\.(css|js)$ {
        limit_except GET { deny all; }
        try_files $uri =404;
    }
    location ~ ^/(build|css|js|fonts|admin-ui|audience)/ {
        limit_except GET { deny all; }
        location ~ \.php { return 404; }
        try_files $uri =404;
    }
    location = /__LIVEWIRE__/livewire.js {
        limit_except GET { deny all; }
        include __FASTCGI_INCLUDE__;
    }
    location = /__LIVEWIRE__/livewire.min.js {
        limit_except GET { deny all; }
        include __FASTCGI_INCLUDE__;
    }
    location / {
        if ($h5_page_test_allowed = 0) { return 503; }
        include __FASTCGI_INCLUDE__;
    }
}
