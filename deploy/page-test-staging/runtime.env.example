# Existing persistent staging. Patch the actual loaded configuration after review.
# Preserve current Owner/MFA, private key, DB password, test assets and token file.
# This is a parameter reference, never an overwrite/install script.
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.sparklingshort.com
APP_KEY=__PRESERVE_EXISTING_APP_KEY__
APP_CONFIG_CACHE=/srv/h5-page-test/shared/bootstrap/config.php
H5_WORKSPACE=h5_page_test
H5_CONTROLLED_STAGING=true
H5_ACQUISITION_STAGING_TEST=true
H5_LOCAL_MODULES=
H5_SIMULATION=false
H5_LOCAL_US_TEST_REGION=false
H5_C_EXPERIENCE_ENABLED=false
H5_C_REGISTRATION_ENABLED=false
H5_VIEWER_EMAIL_PAGES_ENABLED=false
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=h5_page_test
DB_USERNAME=h5_page_test
DB_PASSWORD=__PRESERVE_EXISTING_DB_PASSWORD__
SESSION_DRIVER=database
SESSION_COOKIE=h5_page_test_session
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
CACHE_PREFIX=h5_page_test_
QUEUE_CONNECTION=database
DB_QUEUE=h5_page_test
H5_MEDIA_ROOT=/srv/h5-page-test/shared/media
MAIL_MAILER=array
MAIL_FROM_ADDRESS=staging@example.invalid
H5_BILLING_DRIVER=unconfigured
H5_BILLING_NEW_PURCHASE_PROVIDER=unconfigured
H5_BILLING_PAYPAL_LIVE_ENABLED=false
H5_BILLING_PAYPAL_SANDBOX_ENABLED=false
ACQUISITION_ANALYTICS_ENABLED=false
ACQUISITION_C_ENABLED=false
ACQUISITION_C_SYNTHETIC_POLICY=false
ACQUISITION_R1_OBSERVATIONS_ENABLED=false
ACQUISITION_R1_SYNTHETIC_POLICY=false
ACQUISITION_TRANSPORT=disabled
ACQUISITION_EXTERNAL_ENABLED=false
ACQUISITION_PLATFORM_REVIEWED=false
ACQUISITION_META_API_VERSION=__PRESERVE_EXISTING_META_VERSION__
ACQUISITION_CREDENTIALS_FILE=__PRESERVE_EXISTING_PRIVATE_CREDENTIALS_PATH__
GEOIP_DRIVER=dbip_lite
GEOIP_DATABASE=/srv/h5-page-test/shared/geoip/dbip.mmdb
GEOIP_MAX_AGE_DAYS=45
